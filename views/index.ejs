<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="script.js"></script>
    <script
      src="https://unpkg.com/flowbite@latest/dist/flowbite.min.js"
      defer
    ></script>
    <link rel="stylesheet" href="/output.css" />
    <title>Mini Message Board</title>
  </head>

  <% if(locals.errors) { %> <% errors.forEach(error => { %>
  <div
    id="alert-2"
    class="z-20 fixed top-2 left-2 right-2 flex items-center p-4 mb-4 text-sm text-red-800 rounded-lg bg-red-100 animate-alert [animation-delay:0s,5s]"
    role="alert"
  >
    <svg
      class="w-4 h-4 shrink-0 mr-2"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
    >
      <path
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M10 11h2v5m-2 0h4m-2.592-8.5h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
      />
    </svg>
    <span class="sr-only">Info</span>
    <div class="text-sm"><%= error.msg %></div>
    <button
      type="button"
      class="ml-auto -mx-1.5 -my-1.5 bg-red-100 text-red-800 rounded-lg focus:ring-2 focus:ring-red-400 p-1.5 hover:bg-red-200 inline-flex items-center justify-center h-8 w-8"
      data-dismiss-target="#alert-2"
      aria-label="Close"
    >
      <span class="sr-only">Close</span>
      <svg
        class="w-4 h-4"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18 17.94 6M18 18 6.06 6"
        />
      </svg>
    </button>
  </div>

  <% }) %> <% } %>
  <body class="p-4 bg-color-white dark:bg-gray-900">
    <header
      class="flex justify-between flex-col sm:flex-row items-start sm:items-center w-full mx-auto md:w-5/6 lg:w-1/2"
    >
      <h1
        class="font-bold text-3xl mt-8 mb-6 sm:my-8 text-black dark:text-white"
      >
        <%= title %>
      </h1>
      <form
        class="max-w-60 bg-gray-100 border-1 border-gray-500 dark:border-slate-500 dark:bg-slate-700 p-2 rounded-3xl mb-8 sm:mb-0"
        method="GET"
        action="/search"
      >
        <div class="flex items-center">
          <input type="checkbox" id="toggleSearch" class="peer hidden" />

          <label
            for="toggleSearch"
            class="flex items-center space-x-2 px-2 cursor-pointer"
          >
            <svg
              class="peer dark:fill-gray-200 fill-gray-700"
              xmlns="http://www.w3.org/2000/svg"
              height="24px"
              viewBox="0 -960 960 960"
              width="24px"
              fill="#CCCCCC"
            >
              <path
                d="M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"
              />
            </svg>
          </label>

          <input
            class="self-center hidden peer-checked:block w-full outline-2 outline-blue-400 rounded-2xl px-2 py-1 text-gray-800 dark:text-gray-100"
            type="search"
            name="query"
            id="search"
          />
        </div>
      </form>
      <button
        class="bg-gray-300 dark:bg-gray-600 group my-4 hover:bg-gray-50 p-2 rounded-full opacity-70 fixed z-10 left-1/2 -translate-x-1/2"
        onclick="window.scrollTo({top:document.body.scrollHeight,behavior:'smooth'})"
      >
        <svg
          class="group-hover:fill-slate-900 fill-slate-700 dark:fill-gray-200"
          xmlns="http://www.w3.org/2000/svg"
          height="24px"
          viewBox="0 -960 960 960"
          width="24px"
        >
          <path
            d="M440-800v487L216-537l-56 57 320 320 320-320-56-57-224 224v-487h-80Z"
          />
        </svg>
      </button>
    </header>

    <div
      aria-hidden="true"
      class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80"
    >
      <div
        style="
          clip-path: polygon(
            74.1% 44.1%,
            100% 61.6%,
            97.5% 26.9%,
            85.5% 0.1%,
            80.7% 2%,
            72.5% 32.5%,
            60.2% 62.4%,
            52.4% 68.1%,
            47.5% 58.3%,
            45.2% 34.5%,
            27.5% 76.7%,
            0.1% 64.9%,
            17.9% 100%,
            27.6% 76.8%,
            76.1% 97.7%,
            74.1% 44.1%
          );
        "
        class="relative left-[calc(50%-11rem)] aspect-1155/678 w-144.5 -translate-x-1/2 rotate-30 bg-linear-to-tr from-[#ea97ba] to-[#9995dc] opacity-30 sm:left-[calc(50%-30rem)] sm:w-288.75"
      ></div>
    </div>

    <main class="w-full mx-auto md:w-5/6 lg:w-1/2 my-6">
      <ul
        class="mx-auto mt-8 mb-20 md:mb-32 flex flex-col gap-4 shadow-md rounded p-4 bg-white/80 dark:bg-gray-800/80"
      >
        <% messages.map(message => { %> <% const isCurrentUserMessage =
        message.user === locals.user.username %>
        <a href="/messages/<%= message.id %>">
          <li
            class="px-3 py-2 rounded-2xl relative w-5/6 sm:w-1/2 <%= isCurrentUserMessage ? 'ml-auto rounded-br-sm dark:bg-purple-600 bg-purple-600/85' : 'rounded-bl-sm bg-slate-50 dark:bg-gray-700' %>"
          >
            <% if(!isCurrentUserMessage) { %>
            <h3 class="font-medium mb-0.5 text-gray-900 dark:text-white">
              <%= message.user %>
            </h3>
            <% } %> <% if(message.repliedmessageuser &&
            message.repliedmessagecontent) { %>
            <a class="block" href="/messages/<%= message.repliedmessageid %>">
              <div
                class="px-2 py-0.5 mb-2 border-l-3 rounded dark:border-amber-400 dark:bg-gray-500/30 border-amber-300 bg-gray-200/20"
              >
                <h2
                  class="text-sm font-medium <%= isCurrentUserMessage ? 'text-white' : 'text-gray-700 dark:text-gray-200'%> mb-0.5"
                >
                  Reply to : <%= message.repliedmessageuser %>
                </h2>
                <p
                  class="text-sm <%= isCurrentUserMessage ? 'text-white' : 'text-gray-600 dark:text-gray-300'%> line-clamp-1"
                  dir="auto"
                >
                  <%= message.repliedmessagecontent %>
                </p>
              </div>
            </a>

            <% } %>

            <p
              dir="auto"
              class="text-gray mb-2 break-words <%= isCurrentUserMessage ? 'text-white' : 'text-gray-700 dark:text-gray-300' %> line-clamp-6"
            >
              <%= message.content %>
            </p>

            <span
              class="font-light text-sm absolute bottom-0 translate-y-[100%] <%= isCurrentUserMessage ? 'right-2' : 'left-2' %> text-gray-700 dark:text-gray-200"
              ><%= message.added %></span
            >

            <a
              class="flex items-center p-2 rounded bg-gray-200/20 dark:bg-gray-500/20 w-fit <%= isCurrentUserMessage ? 'ml-auto' : '' %>"
              href="/?reply=<%= message.id %>"
            >
              <span class="sr-only">Reply</span>
              <svg
                class="<%= isCurrentUserMessage ? 'fill-gray-200' : 'dark:fill-gray-200 fill-gray-600' %>"
                xmlns="http://www.w3.org/2000/svg"
                height="16px"
                viewBox="0 -960 960 960"
                width="16px"
              >
                <path
                  d="M760-200v-160q0-50-35-85t-85-35H273l144 144-57 56-240-240 240-240 57 56-144 144h367q83 0 141.5 58.5T840-360v160h-80Z"
                />
              </svg>
            </a>
          </li>
        </a>
        <% }) %>
      </ul>
    </main>
    <div
      aria-hidden="true"
      class="absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]"
    >
      <div
        style="
          clip-path: polygon(
            74.1% 44.1%,
            100% 61.6%,
            97.5% 26.9%,
            85.5% 0.1%,
            80.7% 2%,
            72.5% 32.5%,
            60.2% 62.4%,
            52.4% 68.1%,
            47.5% 58.3%,
            45.2% 34.5%,
            27.5% 76.7%,
            0.1% 64.9%,
            17.9% 100%,
            27.6% 76.8%,
            76.1% 97.7%,
            74.1% 44.1%
          );
        "
        class="relative left-[calc(50%+3rem)] aspect-1155/678 w-144.5 -translate-x-1/2 bg-linear-to-tr from-[#ed96ba] to-[#9791e8] opacity-30 sm:left-[calc(50%+36rem)] sm:w-288.75"
      ></div>
    </div>
    <div
      class="w-full mx-auto md:w-5/6 lg:w-1/2 fixed bottom-0 right-0 left-0 md:bottom-10"
    >
      <% if(locals.currentRepliedMessage) { %>
      <div
        class="px-4 py-2 relative border-l-5 rounded-t-md dark:border-amber-400 dark:bg-gray-600 border-amber-300 bg-gray-200"
      >
        <a class="absolute top-2 right-2" href="/">
          <svg
            class="fill-gray-600 dark:fill-gray-200"
            xmlns="http://www.w3.org/2000/svg"
            height="24px"
            viewBox="0 -960 960 960"
            width="24px"
          >
            <path
              d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"
            />
          </svg>
        </a>
        <h2 class="text-blue-600 dark:text-blue-400 mb-2">
          Reply to : <%= currentRepliedMessage.user %>
        </h2>
        <p
          class="text-sm text-gray-500 dark:text-gray-300 line-clamp-1"
          dir="auto"
        >
          <%= currentRepliedMessage.content %>
        </p>
      </div>

      <% } %>
      <form
        action="/new?reply=<%= locals.currentRepliedMessage &&  locals.currentRepliedMessage.id %>"
        method="POST"
      >
        <label for="chat" class="sr-only">Your message</label>
        <div
          class="flex items-center px-3 py-4 rounded-b-md bg-gray-100 dark:bg-gray-800"
        >
          <!-- Textarea -->
          <textarea
            dir="auto"
            id="chat"
            rows="1"
            class="mx-4 bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-gray-100 text-sm rounded-md focus:ring-blue-500 focus:border-blue-500 block w-full px-3 py-2.5 placeholder:text-gray-500 dark:placeholder:text-gray-400 whitespace-pre break-normal overflow-hidden resize-none max-h-40"
            placeholder="Your message..."
            required
            name="message"
            oninput="this.style.height='auto';this.style.height=this.scrollHeight+'px'"
          ></textarea>

          <!-- Send button -->
          <button
            type="submit"
            class="inline-flex justify-center p-2 text-blue-600 dark:text-blue-400 rounded-full cursor-pointer hover:bg-blue-100 dark:hover:bg-blue-900"
          >
            <svg
              class="w-6 h-6 rotate-90 rtl:-rotate-90"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              fill="none"
              viewBox="0 0 24 24"
            >
              <path
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="m12 18-7 3 7-18 7 18-7-3Zm0 0v-5"
              />
            </svg>
            <span class="sr-only">Send message</span>
          </button>
        </div>
      </form>
    </div>

    <script>
      // Save scroll position before leaving/reloading
      window.addEventListener("beforeunload", () => {
        localStorage.setItem("scrollPosition", window.scrollY);
      });

      // Restore scroll position after render
      window.addEventListener("load", () => {
        const scrollPosition = localStorage.getItem("scrollPosition");
        if (scrollPosition) {
          window.scrollTo(0, parseInt(scrollPosition, 10));
        }
      });
    </script>
  </body>
</html>
